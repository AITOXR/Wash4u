# Copy to .env and fill in. Never commit the real .env file.

# Local dev default: sqlite:///./admin.db
# Production (Railway): the Postgres plugin injects DATABASE_URL automatically.
DATABASE_URL=sqlite:///./admin.db

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Seeded on first `python3 -m app.seed` run. Change the password on first login.
ADMIN_EMAIL=owner@wash4you.in
ADMIN_INITIAL_PASSWORD=

# Fine-grained GitHub PAT scoped to Contents: Read & write on THIS repo
# only (Settings -> Developer settings -> Fine-grained tokens). Leave
# blank to fall back to a local `git commit` in the checkout at REPO_PATH.
GITHUB_TOKEN=
GITHUB_REPO=owner/wash4you2
GITHUB_BRANCH=main

# CORS allowlist for the public contact-form endpoint.
PUBLIC_SITE_ORIGIN=https://wash4you.in

# Cloudflare R2 (large media only — small images go straight into content/media/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Path to the site repo checkout this admin publishes into.
REPO_PATH=..
